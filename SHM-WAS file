# Smart Health & Medical History Tracker + Wellness Analytics System (SHM-WAS)

class Patient:
    def __init__(self, name, age, disease, bp, sugar):
        self.name = name
        self.age = age
        self.disease = disease
        self.bp = bp
        self.sugar = sugar

    def display_record(self):
        print("\n----- Patient Medical Record -----")
        print("Name:", self.name)
        print("Age:", self.age)
        print("Disease History:", self.disease)
        print("Blood Pressure:", self.bp)
        print("Sugar Level:", self.sugar)

    def wellness_analysis(self):
        print("\n----- Wellness Analysis -----")
        if self.bp > 140:
            print("Blood Pressure Status: High")
        else:
            print("Blood Pressure Status: Normal")

        if self.sugar > 140:
            print("Sugar Level Status: High")
        else:
            print("Sugar Level Status: Normal")


# Main Program
name = input("Enter patient name: ")
age = int(input("Enter age: "))
disease = input("Enter disease history: ")
bp = int(input("Enter blood pressure: "))
sugar = int(input("Enter sugar level: "))

patient = Patient(name, age, disease, bp, sugar)

patient.display_record()
patient.wellness_analysis()
